# Copy to .env and fill in. Never commit .env.
GAWE_DB_USER=gawe
GAWE_DB_PASSWORD=
GAWE_DB_NAME=gawe
# Optional (defaults shown). Or set GAWE_DATABASE_URL to a full SQLAlchemy URL instead.
# GAWE_DB_HOST=localhost
# GAWE_DB_PORT=5432

# Password for the limited gawe_app role the API connects as (`make app-role` generates one here).
# GAWE_APP_DB_PASSWORD=

# Key used to sign PolicyDecisions (generate with: python -c "import secrets; print(secrets.token_hex(32))")
GAWE_POLICY_SIGNING_KEY=

# LLM provider (only needed for live runs; tests use the fake provider). Needs: pip install -e ".[llm]"
ANTHROPIC_API_KEY=
GAWE_LLM_MODEL=

# API server (see src/gawe/api/main.py)
GAWE_APP=gawe.apps.contract_review:bundle     # or gawe.apps.it_access:bundle
# GAWE_STORE=postgres                         # or "memory" for a local demo (nothing persists)
GAWE_API_TOKENS_FILE=.dev-tokens.json         # created by `make dev-tokens`
# GAWE_CORS_ORIGINS=http://localhost:3000     # comma-separated; empty means no CORS
# GAWE_WORKERS=4
# GAWE_AUTO_RESUME=1                          # 0 = do not restart unfinished runs at startup
# GAWE_AUTH_FAIL_LIMIT=20                     # failed sign-ins per address ...
# GAWE_AUTH_FAIL_WINDOW_SECONDS=300           # ... in this many seconds, then 429
# GAWE_DEMO_DIR=.demo-data                    # where the mock systems write their ledger
# GAWE_ANCHOR_SINKS=file,rfc3161              # anchor each finished run's audit head; off if unset
# GAWE_ANCHOR_TSA=digicert                    # or sectigo; rfc3161 needs: pip install -e ".[anchor]"
# GAWE_ANCHOR_DIR=.anchors                    # keep it on different storage from the database

# UI (read by the Next.js server only, never sent to the browser)
GAWE_API_URL=http://127.0.0.1:8000
# GAWE_UI_SECURE_COOKIE=1   # set when the UI is served over HTTPS
