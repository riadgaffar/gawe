{
  "name": "gawe-ui",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:models && npm run test:render",
    "check": "npm run typecheck && npm test && npm run build",
    "test:models": "node --experimental-strip-types --no-warnings --test tests/*.test.ts",
    "test:render": "vitest run"
  },
  "dependencies": {
    "next": "^16.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.6.0",
    "vite": "^6.4.6",
    "vitest": "^4.1.12"
  }
}
